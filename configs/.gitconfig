[user]
    email = {email}
    name = {name}
[branch]
    sort = -committerdate
[core]
    fsmonitor = true
    untrackedCache = true
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[color]
    ui = auto
[color "branch"]
    current = yellow bold
    local = green bold
    remote = cyan bold
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
    whitespace = red reverse
[color "status"]
    added = green bold
    changed = yellow bold
    untracked = red bold
[column]
    ui = auto
[commit]
    verbose = true
[fetch]
    prune = true
    pruneTags = true
    all = true
[pretty]
    compact = tformat:%C(auto,yellow)%h %C(auto,blue)%>(16,trunc)%ad %C(auto,green)%<(16,trunc)%aN %C(auto,reset)%s%C(auto,red)% gD% D
[init]
    defaultBranch = main
[help]
    autocorrect = prompt
[log]
    date = relative
[merge]
    conflictstyle = zdiff3
[pull]
    rebase = true
[push]
    default = simple
    autoSetupRemote = true
    followTags = true
[rerere]
    enabled = true
    autoupdate = true
[tag]
    sort = version:refname
[format]
    pretty = compact
[rebase]
    autoStash = true
    updateRefs = true
    autoSquash = true
